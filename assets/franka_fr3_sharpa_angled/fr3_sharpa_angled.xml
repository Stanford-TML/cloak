<mujoco model="fr3">
  <compiler angle="radian" meshdir="meshes"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="fr3">
      <!-- Overwritten in joints 5, 6, and 7. -->
      <joint damping="0.21" armature="0.195" frictionloss="1.137" actuatorgravcomp="true"/>
      <position inheritrange="1"/>
      <default class="visual">
        <geom type="mesh" group="2" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3" mass="0" density="0"/>
      </default>
      <!-- <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/> -->
    </default>

    <default class="sharpa">
    </default>

    <default class="CMC_joint">
      <joint armature="0.0032" frictionloss="0.132" damping="4.20E-05" actuatorgravcomp="true"/>
    </default>
    <default class="PCMC_joint">
      <joint armature="0.00012" frictionloss="0.012" damping="4.20E-05" actuatorgravcomp="true"/>
    </default>
    <default class="MCP_joint">
      <joint armature="0.00265" frictionloss="0.07456" damping="2.38E-05" actuatorgravcomp="true"/>
    </default>
    <default class="PIP_joint">
      <joint armature="0.0006" frictionloss="0.01276"  damping="4.06E-06" actuatorgravcomp="true"/>
    </default>
    <default class="DIP_joint">
      <joint armature="0.00042" frictionloss="0.00378738"  damping="1.21E-06" actuatorgravcomp="true"/>
    </default>
    <default class="elastomer_geom">
      <!-- Michael - this solref reduces stiffness and introduces object penetration. Makes optimizing the grasp reward slightly more unstable. So turn it off. -->
      <!-- <geom solref="0.06 0.9"/> -->
    </default>
  </default>

  <asset>
